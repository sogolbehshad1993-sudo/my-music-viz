{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run -s check)",
      "Bash(npm run -s mood *)",
      "Bash(curl -s localhost:5280/*)",
      "Bash(curl -s 'localhost:5280/*)",
      "Bash(tail *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git revert *)",
      "Bash(git tag *)",
      "Bash(scripts/dev.sh)"
    ],
    "ask": ["Bash(git push *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev.sh", "timeout": 30 }]
      }
    ]
  }
}
